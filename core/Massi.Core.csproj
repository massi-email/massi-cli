<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>default</LangVersion>
    <!--
      Host-agnostic engine shared by the open-source CLI and the hosted Massi service.
      Keep this free of host concerns: no Spectre.Console, no DotNetEnv, no config
      binding, no secrets, and (per ../AGENTS.md) no dependency on hosted-service code.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

</Project>
